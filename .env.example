DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://postgres:postgres@db:5432/formflow
USE_SQLITE=False
USE_REDIS_CACHE=True
POSTGRES_DB=formflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CHANNELS_REDIS_URL=redis://redis:6379/2

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_REQUEST_MAX_PER_WINDOW=5

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@formflow.local

SMS_BACKEND=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CACHE_TTL_FORM_SCHEMA=300
CACHE_TTL_REPORT=60
VISIT_PENDING_TTL_SECONDS=172800
REPORT_WEBHOOK_TIMEOUT_SECONDS=10
PRIVATE_ACCESS_TOKEN_TTL_SECONDS=900
PRIVATE_ACCESS_TOKEN_SALT=formflow-private-access

CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

SENTRY_DSN=
