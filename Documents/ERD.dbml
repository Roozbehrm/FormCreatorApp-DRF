
Table users {
  id bigint [pk]
  username varchar
  email varchar [unique]
  phone varchar [unique, null]
  is_verified boolean
  note: 'AbstractUser سفارشی (apps/accounts)'
}

Table otp_request_logs {
  id bigint [pk]
  identifier varchar
  purpose varchar // register | login | reset
  is_verified boolean
  attempts smallint
  ip varchar [null]
  created_at timestamp
  updated_at timestamp
  note: 'فقط audit — خود کد OTP در Redis است، نه اینجا'
}

Table categories {
  id bigint [pk]
  owner_id bigint [ref: > users.id, not null]
  parent_id bigint [ref: >? categories.id]
  title varchar
  color varchar [null]
  created_at timestamp
  updated_at timestamp
}

Table forms {
  id bigint [pk]
  uuid uuid [unique]
  owner_id bigint [ref: > users.id, not null]
  category_id bigint [ref: >? categories.id]
  title varchar
  description text [null]
  visibility varchar // public | private
  access_password varchar [null]
  is_active boolean
  accepts_responses_until timestamp [null]
  enforce_field_order boolean
  created_at timestamp
  updated_at timestamp
}

Table fields {
  id bigint [pk]
  form_id bigint [ref: > forms.id, not null]
  type varchar // text|textarea|number|select|checkbox|rating|date
  label varchar
  help_text varchar [null]
  order int
  is_required boolean
  config jsonb
  created_at timestamp
  updated_at timestamp
}

Table field_options {
  id bigint [pk]
  field_id bigint [ref: > fields.id, not null]
  label varchar
  value varchar
  order int
}

Table processes {
  id bigint [pk]
  uuid uuid [unique]
  owner_id bigint [ref: > users.id, not null]
  category_id bigint [ref: >? categories.id]
  title varchar
  description text [null]
  visibility varchar
  access_password varchar [null]
  is_active boolean
  type varchar // linear | free
  created_at timestamp
  updated_at timestamp
}

Table process_steps {
  id bigint [pk]
  process_id bigint [ref: > processes.id, not null]
  form_id bigint [ref: > forms.id, not null]
  order int
  is_required boolean
}

Table process_runs {
  id bigint [pk]
  process_id bigint [ref: > processes.id, not null]
  respondent_id bigint [ref: >? users.id]
  session_key varchar
  status varchar // in_progress | completed
  completed_at timestamp [null]
  created_at timestamp
  updated_at timestamp
}

Table submissions {
  id bigint [pk]
  form_id bigint [ref: > forms.id, not null]
  process_run_id bigint [ref: >? process_runs.id]
  respondent_id bigint [ref: >? users.id]
  session_key varchar
  ip varchar [null]
  is_complete boolean
  completed_at timestamp [null]
  created_at timestamp
  updated_at timestamp
  note: 'ذخیره تدریجی: is_complete=False تا finalize_submission صدا زده شود'
}

Table step_completions {
  id bigint [pk]
  run_id bigint [ref: > process_runs.id, not null]
  step_id bigint [ref: > process_steps.id, not null]
  submission_id bigint [ref: - submissions.id, not null, unique]
}

Table answers {
  id bigint [pk]
  submission_id bigint [ref: > submissions.id, not null]
  field_id bigint [ref: > fields.id, not null]
  value jsonb [null]
  value_number decimal [null]
  value_date timestamp [null]
  value_text text [null]
}

Table answer_options {
  id bigint [pk]
  answer_id bigint [ref: > answers.id, not null]
  option_id bigint [ref: > field_options.id, not null]
}

Table visit_counters {
  id bigint [pk]
  target_type varchar // form | process 
  object_id int
  date date
  count int
}

Table report_schedules {
  id bigint [pk]
  owner_id bigint [ref: > users.id, not null]
  target_type varchar [null]
  object_id int [null]
  period varchar // weekly | monthly
  delivery varchar // email | webhook
  email varchar [null]
  webhook_url varchar [null]
  secret varchar [null]
  last_run_at timestamp [null]
  is_active boolean
  created_at timestamp
  updated_at timestamp
}

Table report_deliveries {
  id bigint [pk]
  schedule_id bigint [ref: > report_schedules.id, not null]
  is_success boolean
  status_code smallint [null]
  error text [null]
  created_at timestamp
  updated_at timestamp
}
